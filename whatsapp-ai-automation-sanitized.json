      "name": "Google Gemini Chat Model",
      "notesInFlow": false
    },
    {
      "parameters": {
        "jsCode": "const message = $('Webhook').first().json.body.entry[0].changes[0].value.messages[0].text.body;\n\nlet name = \"UNKNOWN\";\n\n// English\nlet match = message.match(/(?:my name is|i am|i'm)\\s+([A-Za-z]+)/i);\n\nif (match) {\n  name = match[1];\n}\n\n// Urdu\nif (name === \"UNKNOWN\") {\n  let urdu = message.match(/میرا نام\\s+(.+?)\\s+ہے/);\n\n  if (urdu) {\n    name = urdu[1].trim();\n  }\n}\n\nreturn [\n  {\n    json: {\n      output: name\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
